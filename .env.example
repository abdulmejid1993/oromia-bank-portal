TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Production startup requires unique passwords of at least 16 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
MANAGER_USERNAME=manager
MANAGER_PASSWORD=
CASHIER_USERNAME=cashier
CASHIER_PASSWORD=
# Use a long random value in real deployments; pending OTPs expire if this value changes.
OTP_SECRET=
# Set true only for local demos without Twilio; the OTP appears in the server terminal, not the browser.
# This mode is automatically disabled when NODE_ENV=production.
DEMO_OTP_MODE=false
